---
import { WhatsApp, Arrow, Check } from './icons';
import { site, waLink } from '../data/site';

const perks = ['Precios con instalación incluida', 'Pagas cuando el trabajo está listo', 'Equipos Midea e Hisense con WiFi'];
---

<section class="hero">
  <div class="glow" aria-hidden="true"></div>
  <div class="container grid">
    <div class="copy">
      <span class="chip"><span class="dot"></span> Olivar · Sexta Región</span>
      <h1>
        Clima de confianza,<br />
        <em>como en familia.</em>
      </h1>
      <p class="lead">{site.tagline}</p>

      <div class="actions">
        <a class="btn btn-wa" href={waLink()} target="_blank" rel="noopener"><WhatsApp /> Cotizar por WhatsApp</a>
        <a class="btn btn-ghost" href="#equipos">Ver equipos y precios <Arrow /></a>
      </div>

      <ul class="perks">
        {perks.map((p) => <li><Check /> {p}</li>)}
      </ul>
    </div>

    <div class="visual" aria-hidden="true">
      <div class="panel">
        <svg class="air" viewBox="0 0 400 160" fill="none">
          <path d="M20 40c60 0 80-20 140-20s80 20 140 20 80-20 80-20" />
          <path d="M20 90c60 0 80-20 140-20s80 20 140 20 80-20 80-20" />
          <path d="M20 140c60 0 80-20 140-20s80 20 140 20 80-20 80-20" />
        </svg>
        <img src="/img/AIRE1.jpg" alt="" width="1080" height="660" fetchpriority="high" />
        <div class="float temp">
          <span class="big">23°</span>
          <span>Fresquito en casa</span>
        </div>
        <div class="float trust">
          <span class="avatar">OC</span>
          <span><b>Atención directa</b><br />Hablas con quien instala</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero { position: relative; padding-block: clamp(40px, 7vw, 96px) clamp(56px, 8vw, 112px); overflow: clip; }
  .glow {
    position: absolute; inset: -20% -10% auto auto; width: 70vw; height: 70vw; max-width: 900px; max-height: 900px;
    background: radial-gradient(closest-side, color-mix(in oklch, var(--sky-500) 22%, transparent), transparent 70%),
      radial-gradient(closest-side at 30% 70%, color-mix(in oklch, var(--olive-400) 28%, transparent), transparent 70%);
    filter: blur(20px); pointer-events: none;
  }
  .grid { position: relative; display: grid; gap: clamp(40px, 6vw, 72px); align-items: center; }
  @media (min-width: 960px) { .grid { grid-template-columns: 1.05fr 1fr; } }

  .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--wa); box-shadow: 0 0 0 4px color-mix(in oklch, var(--wa) 25%, transparent); }
  h1 { font-size: clamp(2.6rem, 7vw, 5rem); margin-block: 20px 20px; letter-spacing: -0.035em; }
  h1 em {
    font-style: normal;
    background: linear-gradient(100deg, var(--brand) 10%, var(--accent) 90%);
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .lead { font-size: clamp(1.0625rem, 1.6vw, 1.25rem); color: var(--muted); max-width: 560px; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }
  .actions .btn svg:last-child:not(:first-child) { width: 18px; }
  .perks { list-style: none; padding: 0; margin-top: 32px; display: grid; gap: 10px; }
  .perks li { display: flex; gap: 10px; align-items: center; font-weight: 500; font-size: 0.975rem; }
  .perks svg { width: 20px; height: 20px; color: var(--brand); flex: none; }

  .panel {
    position: relative; aspect-ratio: 5 / 4; border-radius: var(--radius-lg);
    background: linear-gradient(160deg, var(--sky-200), var(--olive-100));
    display: grid; place-items: center; padding: 8%;
    box-shadow: var(--shadow-lg);
  }
  .panel img { position: relative; width: 100%; height: auto; border-radius: 18px; mix-blend-mode: multiply; }
  .air { position: absolute; left: 8%; right: 8%; bottom: 10%; width: 84%; opacity: .55; }
  .air path {
    stroke: var(--sky-500); stroke-width: 3; stroke-linecap: round;
    stroke-dasharray: 40 18; animation: flow 3s linear infinite;
  }
  .air path:nth-child(2) { animation-duration: 3.6s; opacity: .7; }
  .air path:nth-child(3) { animation-duration: 4.4s; opacity: .45; }
  @keyframes flow { to { stroke-dashoffset: -232; } }

  .float {
    position: absolute; display: flex; align-items: center; gap: 12px;
    background: color-mix(in oklch, var(--surface) 88%, transparent);
    backdrop-filter: blur(10px); border: 1px solid var(--line);
    border-radius: 18px; padding: 12px 16px; box-shadow: var(--shadow);
    font-size: 0.875rem; line-height: 1.3; color: var(--text);
    animation: bob 6s ease-in-out infinite;
  }
  .temp { top: 7%; right: 6%; }
  .temp .big { font-family: var(--font-display); font-size: 2rem; font-weight: 700; color: var(--accent); }
  .trust { bottom: 6%; left: 5%; animation-delay: -3s; }
  .avatar {
    width: 40px; height: 40px; border-radius: 50%; display: grid; place-items: center;
    background: var(--brand); color: var(--on-brand); font-weight: 700; font-size: 0.8rem;
  }
  @keyframes bob { 50% { transform: translateY(-8px); } }
  @media (prefers-reduced-motion: reduce) { .float, .air path { animation: none; } }
  @media (max-width: 480px) { .float { font-size: 0.75rem; padding: 8px 12px; } .temp .big { font-size: 1.5rem; } }
</style>
