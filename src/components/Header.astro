---
import Logo from './Logo.astro';
import { WhatsApp } from './icons';
import { waLink } from '../data/site';

const links = [
  { href: '#servicios', label: 'Servicios' },
  { href: '#equipos', label: 'Equipos y precios' },
  { href: '#calculadora', label: '¿Qué equipo necesito?' },
  { href: '#cobertura', label: 'Cobertura' },
  { href: '#preguntas', label: 'Preguntas' },
];
---

<header class="header">
  <div class="container bar">
    <a href="/" aria-label="Olivar Clima, inicio"><Logo /></a>

    <nav class="desktop" aria-label="Principal">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>

    <a class="btn btn-wa cta" href={waLink()} target="_blank" rel="noopener">
      <WhatsApp /> Cotizar
    </a>

    <button class="menu-btn" popovertarget="menu" aria-label="Abrir menú">
      <span></span><span></span>
    </button>
  </div>

  <nav id="menu" popover aria-label="Menú móvil">
    {links.map((l) => <a href={l.href} onclick="this.parentElement.hidePopover()">{l.label}</a>)}
    <a class="btn btn-wa" href={waLink()} target="_blank" rel="noopener"><WhatsApp /> Cotizar por WhatsApp</a>
  </nav>
</header>

<style>
  .header {
    position: sticky; top: 0; z-index: 50;
    background: color-mix(in oklch, var(--bg) 78%, transparent);
    backdrop-filter: blur(16px) saturate(1.4);
    -webkit-backdrop-filter: blur(16px) saturate(1.4);
    border-bottom: 1px solid color-mix(in oklch, var(--line) 70%, transparent);
  }
  .bar { display: flex; align-items: center; gap: 24px; min-height: 72px; }
  .bar > a:first-child { text-decoration: none; }
  .desktop { display: none; gap: 4px; margin-inline: auto; }
  .desktop a {
    padding: 8px 14px; border-radius: 999px; text-decoration: none;
    font-size: 0.9375rem; font-weight: 500; color: var(--muted);
    transition: color .2s, background-color .2s;
  }
  .desktop a:hover { color: var(--text); background: var(--bg-soft); }
  .cta { display: none; min-height: 44px; padding: 0 18px; }
  .menu-btn {
    margin-left: auto; width: 44px; height: 44px; border-radius: 12px;
    border: 1px solid var(--line); background: var(--surface);
    display: grid; place-content: center; gap: 6px;
  }
  .menu-btn span { display: block; width: 18px; height: 2px; border-radius: 2px; background: var(--text); }

  #menu {
    inset: 80px 16px auto 16px; width: auto; margin: 0;
    padding: 12px; border-radius: var(--radius); border: 1px solid var(--line);
    background: var(--surface); color: var(--text); box-shadow: var(--shadow-lg);
    flex-direction: column; gap: 4px;
  }
  #menu:popover-open { display: flex; animation: drop .22s ease; }
  #menu a:not(.btn) { padding: 14px 16px; border-radius: 12px; text-decoration: none; font-weight: 500; }
  #menu a:not(.btn):hover { background: var(--bg-soft); }
  #menu .btn { margin-top: 8px; }
  #menu::backdrop { background: oklch(0.2 0.03 125 / 0.3); backdrop-filter: blur(2px); }
  @keyframes drop { from { opacity: 0; transform: translateY(-8px); } }

  @media (min-width: 1040px) {
    .desktop { display: flex; }
    .cta { display: inline-flex; }
    .menu-btn { display: none; }
  }
</style>
