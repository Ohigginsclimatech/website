---
interface Props { light?: boolean }
const { light = false } = Astro.props;
---

<span class:list={['logo', { light }]}>
  <svg viewBox="0 0 64 64" aria-hidden="true">
    <rect width="64" height="64" rx="16" class="tile" />
    <path d="M32 50C32 50 15 42 15 26C15 17 22 12 32 12C42 12 49 17 49 26C49 42 32 50 32 50Z" class="leaf" />
    <path d="M32 46V20" class="vein" stroke-width="3" stroke-linecap="round" />
    <path d="M22 30c4 0 6-2 10-2s6 2 10 2M22 37c4 0 6-2 10-2s6 2 10 2" class="air" stroke-width="2.6" stroke-linecap="round" fill="none" />
  </svg>
  <span class="word">Olivar<b>Clima</b></span>
</span>

<style>
  .logo { display: inline-flex; align-items: center; gap: 10px; }
  svg { width: 38px; height: 38px; flex: none; }
  .tile { fill: var(--olive-700); }
  .leaf { fill: var(--olive-400); }
  .vein { stroke: var(--olive-700); }
  .air { stroke: oklch(0.97 0.01 95); }
  .word {
    font-family: var(--font-display); font-size: 1.375rem; font-weight: 600;
    letter-spacing: -0.03em; color: var(--brand-strong);
  }
  .word b { font-weight: 800; color: var(--brand); }
  .light .word { color: #fff; }
  .light .word b { color: var(--olive-400); }
</style>
